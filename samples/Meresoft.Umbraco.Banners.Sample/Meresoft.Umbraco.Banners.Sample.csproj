<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The sample uses a few Umbraco APIs that are marked obsolete; it is not part of the package surface. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>Meresoft.Umbraco.Banners.Sample</RootNamespace>
    <!-- Admin credentials are read from user-secrets or environment variables, never from the repository. -->
    <UserSecretsId>meresoft-umbraco-banners-sample</UserSecretsId>
    <CopyRefAssembliesToPublishDirectory>false</CopyRefAssembliesToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Meresoft.Umbraco.Banners\Meresoft.Umbraco.Banners.csproj" />
  </ItemGroup>

</Project>
